# Clerk — keep these ABSENT (not empty!) until you claim the keyless dev
# instance or create a Clerk app: defined-but-empty vars break Clerk's
# keyless dev mode. `clerk env pull` or the dashboard gives you real values.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# Optional: GitHub token for higher API rate limits (5,000/h instead of 60/h).
# A fine-grained PAT with public-repo read-only access is enough.
# GITHUB_TOKEN=

# Optional: where the SQLite database lives (defaults to ./data/app.db).
# DATABASE_PATH=

# Optional: canonical origin for sitemap/canonical/OG URLs
# (defaults to https://legal-oss.com).
# NEXT_PUBLIC_SITE_URL=

# Site admins: comma-separated Clerk user ids allowed to feature projects.
# ADMIN_USER_IDS=

# Bearer token for the admin index-repos endpoint; unset disables it.
# ADMIN_API_TOKEN=

# PostHog product analytics (client-side). Public project key (phc_…); leave
# blank to disable PostHog entirely. Cookieless capture runs before consent —
# enable "Cookieless server hash mode" in the PostHog project settings.
# NEXT_PUBLIC_POSTHOG_KEY=
# PostHog ingestion host. EU cloud by default; use https://us.i.posthog.com for US.
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Brevo (Sendinblue) v3 API key + contact list id for the featured-projects
# newsletter. `pnpm newsletter:setup` creates the list and prints the id.
# BREVO_API_KEY=
# BREVO_LIST_ID=
